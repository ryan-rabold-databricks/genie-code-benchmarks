{
  "datasets": [
    {
      "name": "ds_kpi",
      "displayName": "KPIs",
      "queryLines": [
        "SELECT\n",
        "  (SELECT count(*) FROM unit_cost_benchmarks WHERE is_current) AS workloads_benchmarked,\n",
        "  (SELECT avg(1 - c.dbus_per_unit / nullif(b.dbus_per_unit, 0)) FROM unit_cost_benchmarks c\n",
        "     JOIN unit_cost_benchmarks b ON b.workload_id = c.workload_id AND b.effort = c.effort AND b.config = 'baseline'\n",
        "     WHERE c.is_current AND c.config <> 'baseline') AS avg_reduction,\n",
        "  (SELECT count(*) FROM benchmark_run_results WHERE status = 'valid') AS runs_counted\n"
      ]
    },
    {
      "name": "ds_current",
      "displayName": "Current unit-cost benchmarks",
      "queryLines": [
        "SELECT concat(w.workload_name, ' (', b.effort, ')') AS workload_name, w.unit_of_measure, b.config, coalesce(b.skill_version, '-') AS skill_version, b.effort,\n",
        "       b.n_runs, b.cost_per_unit_usd, b.min_run_cost_per_unit, b.max_run_cost_per_unit, b.spread_pct / 100 AS spread_pct, b.turns_per_unit, b.dbus_per_unit, b.units_per_100_usd,\n",
        "       b.business_user_multiplier, b.price_source, b.published_at\n",
        "FROM unit_cost_benchmarks b\n",
        "JOIN benchmark_workloads w USING (workload_id)\n",
        "WHERE b.is_current\n",
        "ORDER BY b.cost_per_unit_usd\n"
      ]
    },
    {
      "name": "ds_compare",
      "displayName": "Baseline vs current",
      "queryLines": [
        "SELECT concat(w.workload_name, ' (', b.effort, ')') AS workload_name,\n",
        "       CASE WHEN b.config = 'baseline' THEN '1 Baseline' ELSE '2 With skill' END AS version_label,\n",
        "       b.cost_per_unit_usd, b.turns_per_unit\n",
        "FROM unit_cost_benchmarks b\n",
        "JOIN benchmark_workloads w USING (workload_id)\n",
        "WHERE b.config = 'baseline' OR b.is_current\n",
        "ORDER BY w.workload_name, version_label\n"
      ]
    },
    {
      "name": "ds_decisions",
      "displayName": "Release gate decisions",
      "queryLines": [
        "SELECT d.decided_at, w.workload_name, d.candidate_config, coalesce(d.candidate_skill_version, '-') AS candidate_skill_version,\n",
        "       d.candidate_n_runs, d.candidate_cost_per_unit, d.current_cost_per_unit, d.delta_pct / 100 AS delta_pct, d.decision, d.reason\n",
        "FROM benchmark_decisions d\n",
        "JOIN benchmark_workloads w USING (workload_id)\n",
        "ORDER BY d.decided_at DESC, w.workload_name\n"
      ]
    },
    {
      "name": "ds_runs",
      "displayName": "Benchmark runs",
      "queryLines": [
        "SELECT r.start_ts, w.workload_name, r.config, coalesce(r.skill_version, '-') AS skill_version, r.effort, r.runner_type,\n",
        "       r.run_by, r.artifacts_produced, r.dbus, r.turns, r.cost_usd, r.noise_turns, r.overlapping_runs, r.free_dbus, r.price_source, r.status\n",
        "FROM benchmark_run_results r\n",
        "JOIN benchmark_workloads w USING (workload_id)\n",
        "ORDER BY r.start_ts DESC\n"
      ]
    }
  ],
